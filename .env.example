# Server-Secrets gehören ausschließlich in die Umgebung – niemals in VITE_ Variablen oder Browser-Code.
# Die lokale Produktdemo funktioniert vollständig ohne bezahlte KI.

# Bezahlte Anthropic-Aufrufe sind doppelt opt-in: Credential + SYMMEDIS_AI_ENABLED=true.
ANTHROPIC_API_KEY=
SYMMEDIS_AI_ENABLED=false

# Optional – nur für eine bewusst aktivierte KI-Phase:
# ANTHROPIC_MODEL=<verifizierte-modell-id>
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# PORT=4173

# --- Supabase / echte Authentifizierung (Build-Zeit, Vite-Präfix VITE_) ----
# Beide Werte müssen gesetzt sein, damit /login, /portal und /intern die echte Zugriffsschicht nutzen.
# Ausschließlich den Publishable Key verwenden – niemals service_role oder Secret Keys.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Öffentliche Website (Build-Zeit, Vite-Präfix VITE_) ------------------
# Optionaler externer Terminbuchungsdienst. Gesetzt → zusätzlicher externer Buchungsbutton auf /termin.
# Ohne URL bleibt das integrierte Diagnosegespräch-Formular aktiv und überträgt Anfragen über den geschützten submit-lead-Endpunkt.
# VITE_BOOKING_URL=
#
# Basis-URL für kanonische Links und og:url (z. B. https://symmedis.de).
# VITE_SITE_URL=
#
# Indexierung erst bei exakt "true" freigeben; sonst noindex, nofollow.
VITE_PUBLIC_LAUNCH=false
