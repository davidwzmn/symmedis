# Kein API-Key im Code – ausschließlich über Umgebungsvariablen.
# Ohne Key läuft die Demo automatisch im lokalen Demo-Modell weiter
# (gekennzeichnet als "Demo-Modell" statt "KI-Analyse").

ANTHROPIC_API_KEY=

# Optional – Standardwerte:
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# PORT=4173

# --- Supabase / echte Authentifizierung (Build-Zeit, Vite-Präfix VITE_) ----
# Beide Werte müssen gesetzt sein, damit der Login von Demo auf echte Auth
# umschaltet. Ausschließlich den Publishable Key verwenden – niemals service_role.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Öffentliche Website (Build-Zeit, Vite-Präfix VITE_) ------------------
# Externer Terminbuchungsdienst. Gesetzt → externer Buchungsbutton auf /termin.
# Leer → Demo-Formular mit Demo-Hinweis bleibt aktiv (keine Übertragung).
# VITE_BOOKING_URL=
#
# Basis-URL für kanonische Links und og:url (z. B. https://symmedis.de).
# VITE_SITE_URL=
#
# Indexierung erst bei exakt "true" freigeben; sonst noindex, nofollow.
# VITE_PUBLIC_LAUNCH=false
